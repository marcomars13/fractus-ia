from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

app = FastAPI(title="Fractus API", version="1.0")

# Autoriser ton front en dev
origins = [
    "http://localhost:3000",
    "http://127.0.0.1:3000",
    "http://192.168.1.60:3000",  # ton réseau local
]

app.add_middleware(
    CORSMiddleware,
    allow_origins=origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

class AnomalyRequest(BaseModel):
    sequence: str

@app.get("/")
async def root():
    return {"message": "Backend Fractus opérationnel 🚀"}

@app.get("/health")
async def health():
    return {"ok": True}

@app.post("/anomaly/full")
async def anomaly_full(request: AnomalyRequest):
    seq = request.sequence
    return {
        "message": "ok",
        "result": {
            "length": len(seq),
            "preview": seq[:20],
            "status": "analysé"
        }
    }

