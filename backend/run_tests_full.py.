"""
run_tests_full.py — Comparaison Plonk vs Plonk+Fractus
"""

import sys
import cv2
import numpy as np
from PIL import Image
import traceback
import plonk_infer  # Ton wrapper Plonk
from fractus import compute_fractus_scores
from fractus_profile_utils import load_fractus_profile

# ------------------------
# 🔹 Charger profil Fractus
# ------------------------
PROFILE = load_fractus_profile("mapillary_out/fractus_profile.json")

# ------------------------
# 🔹 Plonk seul
# ------------------------
def run_plonk_api(image_arr):
    try:
        print("🚀 [run_plonk_api] start")
        preds = plonk_infer.plonk_predict(Image.fromarray(image_arr))
        print(f"✅ [run_plonk_api] output: {preds}")
        return preds[0] if preds else {
            "lat": None,
            "lon": None,
            "score": 0,
            "meta": {"engine": "plonk (empty)"}
        }
    except Exception as e:
        err_msg = traceback.format_exc()
        print(f"⚠️ [run_plonk_api] fallback:\n{err_msg}")
        return {
            "lat": 48.8566,
            "lon": 2.3522,
            "score": 0,
            "meta": {"engine": "plonk (fallback)", "error": str(e)}
        }

# ------------------------
# 🔹 Plonk + Fractus Full
# ------------------------
def run_fractus_full_api(image_arr):
    print("🚀 [run_fractus_full_api] start")
    try:
        preds = plonk_infer.plonk_predict(Image.fromarray(image_arr))
        if not preds:
            return {"lat": None, "lon": None, "meta": {"engine": "FractusFull (empty)"}}

        base = preds[0]
        lat, lon = base["lat"], base["lon"]

        # Fractus score brut
        scores = compute_fractus_scores(image_arr, PROFILE["params"]["window"], PROFILE["params"]["pattern"])
        fractus_shift = np.mean(scores) if scores is not None else 0.0

        # Correction avec profil
        lat = PROFILE["geo"]["lat_mean"] + fractus_shift * PROFILE["geo"]["lat_std"]
        lon = PROFILE["geo"]["lon_mean"] + fractus_shift * PROFILE["geo"]["lon_std"]

        # 🔒 Clamp dans les bornes valides
        lat = np.clip(lat, -90, 90)
        lon = ((lon + 180) % 360) - 180

        return {"lat": lat, "lon": lon, "meta": {"engine": "FractusFull"}}
    except Exception as e:
        err_msg = traceback.format_exc()
        print(f"⚠️ [run_fractus_full_api] error:\n{err_msg}")
        return {"lat": None, "lon": None, "meta": {"engine": "FractusFull (error)", "error": str(e)}}

# ------------------------
# 🔹 Main
# ------------------------
if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("❌ Usage: python run_tests_full.py <image_path>")
        sys.exit(1)

    img_path = sys.argv[1]
    img = cv2.imread(img_path)
    if img is None:
        print(f"❌ Impossible de lire l'image: {img_path}")
        sys.exit(1)

    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    # Plonk
    plonk_res = run_plonk_api(img_rgb)

    # Fractus
    fractus_res = run_fractus_full_api(img_rgb)

    # Distance entre prédictions
    if plonk_res["lat"] is not None and fractus_res["lat"] is not None:
        dlat = plonk_res["lat"] - fractus_res["lat"]
        dlon = plonk_res["lon"] - fractus_res["lon"]
        dist = np.sqrt(dlat**2 + dlon**2) * 111  # approx km
    else:
        dist = None

    print("\n📊 Résultats comparés :")
    print(f"   ➤ Plonk seul       : lat={plonk_res['lat']}, lon={plonk_res['lon']}")
    print(f"   ➤ Plonk + Fractus  : lat={fractus_res['lat']}, lon={fractus_res['lon']}  [Plonk+Fractus]")
    if dist is not None:
        print(f"📏 Distance (ajustement) : {dist:.2f} km")

